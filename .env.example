# LinqAlpha API Configuration
# Copy this file to .env and fill in your actual values

# Required: LinqAlpha API Key for Search Chat
# Get your API key from: https://api.linqalpha.com
LINQALPHA_API_KEY=your_api_key_here

# Optional: RMS features configuration (required for RMS Chat and Deep Research)
# LINQALPHA_ORG_ID=your_org_id_here
# LINQALPHA_USER_ID=your_user_id_here
# LINQALPHA_USER_EMAIL=your_email_here
# LINQALPHA_USER_NAME=your_name_here
